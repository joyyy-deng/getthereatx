{
  "name": "getthereatx-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-content && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "validate-content": "tsx scripts/validate-content.ts",
    "check-links": "tsx scripts/check-links.ts",
    "import-sheet": "tsx scripts/import-sheet.ts",
    "build:wp": "npm run validate-content && tsc -b && vite build --config vite.wp.config.ts",
    "build:elementor": "tsx scripts/build-elementor-home.ts",
    "zip:wp": "npm run build:wp && cd wordpress && rm -f gtatx-tools.zip && zip -rq gtatx-tools.zip gtatx-tools -x '*.DS_Store' 'gtatx-tools/templates/*' 'gtatx-tools/includes/local-templates.php'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:elementor:templates": "tsx scripts/build-elementor-templates.ts",
    "build:elementor:site": "tsx scripts/build-elementor-site.ts",
    "build:elementor:art": "tsx scripts/export-elementor-art.ts",
    "check:elementor": "tsx scripts/check-elementor.ts",
    "seed:wp": "tsx scripts/build-wp-seed.ts && cd wordpress && npx @wordpress/env run cli wp eval-file wp-content/gtatx-local-dev/seed.php",
    "fetch-share-images": "tsx scripts/fetch-share-images.ts",
    "import-resource-list": "tsx scripts/import-resource-list.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.5",
    "@fontsource/geist-sans": "^5.2.5",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.18",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
