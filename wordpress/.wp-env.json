{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.1.4.zip",
  "phpVersion": "8.4",
  "plugins": [
    "./gtatx-tools",
    "https://downloads.wordpress.org/plugin/elementor.4.3.6.zip",
    "https://downloads.wordpress.org/plugin/the-events-calendar.latest-stable.zip",
    "https://downloads.wordpress.org/plugin/advanced-custom-fields.latest-stable.zip",
    "https://downloads.wordpress.org/plugin/classic-editor.latest-stable.zip"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "GTATX_LOCAL_TEMPLATES": true
  },
  "testsEnvironment": false,
  "mappings": {
    "wp-content/uploads/gtatx-sample": "./elementor",
    "wp-content/mu-plugins/gtatx-allow-local-images.php": "./local-dev/allow-local-images.php",
    "wp-content/mu-plugins/gtatx-live-styles.php": "./local-dev/live-styles.php",
    "wp-content/mu-plugins/gtatx-live-css": "./local-dev/live-css",
    "wp-content/gtatx-local-dev": "./local-dev",
    "wp-content/gtatx-public": "../public"
  }
}
